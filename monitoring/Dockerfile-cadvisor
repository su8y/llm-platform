FROM gcr.io/cadvisor/cadvisor:v0.47.0

LABEL description="Custom cAdvisor for LLM Platform monitoring"

EXPOSE 8080

CMD ["/usr/bin/cadvisor", \
     "-logtostderr", \
     "-docker_only=true", \
     "-store_container_labels=true", \
     "-whitelisted_container_labels=com.docker.compose.service,com.docker.compose.project"]